---
import ScrollReveal from "./ScrollReveal";
import { historia } from "../data/historia";

const { principles } = historia;
---

<section
  class="bg-brand-light px-5 pb-10"
  aria-labelledby="principios-title"
>
  <div class="mx-auto flex w-full max-w-lg flex-col gap-5 text-theme-black md:max-w-2xl">
    <p class="kicker" id="principios-title" data-scroll-fade>{principles.kicker}</p>
    <h2 class="flex flex-col gap-1 text-[32px] font-semibold leading-10 md:text-4xl md:leading-[44px]">
      {
        principles.lines.map((line) => (
          <ScrollReveal
            client:visible
            as="span"
            containerClassName="block"
            text={`${line.accent}${line.rest}`}
            textClassName="text-[32px] font-semibold leading-10 md:text-4xl md:leading-[44px]"
            accentWords={[line.accent]}
            accentClassName="text-accent"
          />
        ))
      }
    </h2>
  </div>
</section>
