---
import Badge from "./Badge.astro";
import { GiftSlider } from "./GiftSlider";
import ScrollReveal from "./ScrollReveal";
import { site } from "../data/site";

const { gift } = site;
---

<section
  id="regalo"
  class="bg-theme-black px-5 py-10"
  aria-labelledby="regalo-title"
>
  <div class="mx-auto flex w-full max-w-lg flex-col items-center gap-8">
    <div class="flex w-full flex-col gap-5 text-theme-white">
      <p class="kicker" data-scroll-fade>{gift.kicker}</p>
      <ScrollReveal
        client:visible
        as="h2"
        id="regalo-title"
        text={gift.title}
        textClassName="text-5xl font-semibold leading-[1.15] md:text-6xl"
      />
      <ScrollReveal
        client:visible
        as="p"
        text={gift.intro}
        textClassName="text-lg font-normal leading-7"
      />
      <div class="flex flex-wrap gap-5" data-scroll-fade>
        {gift.badges.map((label) => <Badge label={label} variant="accent2" />)}
      </div>
    </div>

    <div class="w-full" data-scroll-fade>
      <GiftSlider client:load slides={gift.slides} ctaHref={site.cta.href} />
    </div>

    <ScrollReveal
      client:visible
      as="p"
      containerClassName="w-full"
      text={gift.note}
      textClassName="text-base font-normal leading-6 text-theme-white"
    />
  </div>
</section>
