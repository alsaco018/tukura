---
import Button from "./Button.astro";
import ScrollReveal from "./ScrollReveal";
import { site } from "../data/site";

const { about } = site;
---

<section
  id="quien-soy"
  class="bg-accent pt-10 text-theme-white"
  aria-labelledby="quien-soy-title"
>
  <div class="mx-auto flex w-full max-w-lg flex-col gap-6 px-5 md:max-w-2xl">
    <div class="flex flex-col gap-5">
      <p class="kicker" data-scroll-fade>{about.kicker}</p>
      <ScrollReveal
        client:visible
        as="h2"
        id="quien-soy-title"
        text={about.name}
        textClassName="text-5xl font-semibold leading-[1.15] md:text-6xl"
      />
      <ScrollReveal
        client:visible
        as="p"
        text={about.body}
        textClassName="text-lg font-normal leading-7"
      />
    </div>

    <blockquote class="border-l-2 border-theme-white pl-6">
      <ScrollReveal
        client:visible
        as="p"
        text={about.quote}
        textClassName="text-xl italic leading-[28px]"
      />
    </blockquote>

    <Button href={about.ctaHref} label={about.ctaLabel} variant="secondary" scrollFade />
  </div>

  <div class="mt-6 h-[353px] w-full overflow-hidden" data-scroll-fade>
    <img
      src={about.image}
      alt="Patri Guillén en un ambiente de bienestar"
      class="h-full w-full object-cover"
      width="786"
      height="706"
      loading="lazy"
    />
  </div>
</section>
