---
interface Props {
  href: string;
  label: string;
  variant?: "primary" | "secondary";
  class?: string;
}

const { href, label, variant = "secondary", class: className = "" } = Astro.props;

const isExternal = href.startsWith("http");

const variants = {
  primary:
    "bg-accent text-theme-white hover:bg-accent-medium focus-visible:outline-theme-white",
  secondary:
    "bg-theme-white text-theme-black hover:bg-brand-lighter focus-visible:outline-theme-white",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-full px-8 py-2 text-base font-semibold leading-6 transition-colors focus-visible:outline-2 focus-visible:outline-offset-2",
    variants[variant],
    className,
  ]}
  target={isExternal ? "_blank" : undefined}
  rel={isExternal ? "noopener noreferrer" : undefined}
>
  {label}
</a>
