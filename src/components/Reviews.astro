---
import ScrollReveal from "./ScrollReveal";
import { ReviewsSlider } from "./ReviewsSlider";
import { reviews } from "../data/reviews";
---

<section
  id="resenas"
  class="bg-brand-light px-5 py-8"
  aria-labelledby="resenas-title"
>
  <div class="mx-auto flex w-full max-w-lg flex-col gap-8 md:max-w-2xl">
    <header class="flex flex-col gap-5 text-theme-black">
      <p class="kicker" data-scroll-fade>reseñas</p>
      <ScrollReveal
        client:visible
        as="h2"
        id="resenas-title"
        text="Apreciamos tu opinión"
        textClassName="text-5xl font-semibold leading-[1.15] md:text-6xl"
      />
    </header>

    {/* No data-scroll-fade: opacity compositing clips DepthCarousel card shadows */}
    <div>
      <ReviewsSlider client:visible reviews={reviews} />
    </div>
  </div>
</section>
