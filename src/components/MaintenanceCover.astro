---
import Button from "./Button.astro";
import { site } from "../data/site";

const message = "Estamos trabajando en la web";
const support =
  "Mientras tanto, puedes pedirnos cita desde el formulario de reserva. Pronto tendrás aquí todo TUKURA.";
---

<section
  class="relative h-dvh w-full overflow-hidden bg-accent text-theme-black"
  aria-label="Página en preparación"
>
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-1/3 opacity-40"
    aria-hidden="true"
    style="background:
      radial-gradient(120% 80% at 50% -10%, rgba(253, 249, 247, 0.2), transparent 60%),
      repeating-radial-gradient(circle at 50% -20%, transparent 0 18px, rgba(253, 249, 247, 0.1) 18px 19px);"
  >
  </div>

  <div class="relative z-10 flex h-full w-full flex-col items-center px-6 pt-10 pb-[38vh] md:pt-14 md:pb-[42vh]">
    <header class="flex flex-col items-center gap-2 text-center">
      <h1 class="font-display text-[clamp(2.75rem,12vw,5.5rem)] leading-none tracking-wide text-theme-black">
        TUKURA
      </h1>
      <p class="text-sm font-normal tracking-[0.08em] text-theme-black/80 md:text-base">
        Masaje &amp; Bienestar
      </p>
    </header>

    <div class="flex flex-1 flex-col items-center justify-center gap-6 text-center">
      <div class="flex max-w-md flex-col items-center gap-3">
        <p class="kicker text-theme-white">Próximamente</p>
        <h2 class="text-2xl font-semibold leading-8 text-theme-white md:text-3xl md:leading-10">
          {message}
        </h2>
        <p class="text-base font-normal leading-6 text-theme-white/90">
          {support}
        </p>
      </div>

      <Button
        href="/#contacto"
        label="Pedir cita"
        variant="secondary"
      />
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 z-0 flex justify-center opacity-70"
    aria-hidden="true"
  >
    <img
      src="/icons/turtle.svg"
      alt=""
      width="106"
      height="64"
      class="h-auto w-[min(140vw,920px)] translate-y-[8%] select-none md:w-[min(110vw,1100px)] md:translate-y-[10%]"
    />
  </div>
</section>
