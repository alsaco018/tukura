---
import { SpaceGallery } from "./SpaceGallery";
import ScrollReveal from "./ScrollReveal";
import { site } from "../data/site";

const { space } = site;
---

<section
  id="espacio"
  class="relative overflow-hidden bg-brand-light px-5 py-10"
  aria-labelledby="espacio-title"
>
  <div class="relative mx-auto flex w-full max-w-lg flex-col gap-8 md:max-w-2xl">
    <div class="flex flex-col gap-5 text-theme-black">
      <p class="kicker" data-scroll-fade>{space.kicker}</p>
      <ScrollReveal
        client:visible
        as="h2"
        id="espacio-title"
        text={space.title}
        textClassName="text-5xl font-semibold leading-[1.15] md:text-6xl"
      />
      <div class="flex flex-col gap-4 text-lg font-normal leading-7">
        {
          space.paragraphs.map((paragraph) => (
            <ScrollReveal
              client:visible
              as="p"
              text={paragraph}
              textClassName="text-lg font-normal leading-7"
            />
          ))
        }
      </div>
    </div>

    <div data-scroll-fade class="w-full">
      <SpaceGallery client:visible images={space.images} />
    </div>
  </div>
</section>
