---
interface Props {
  label: string;
  variant?: "accent" | "accent2";
}

const { label, variant = "accent" } = Astro.props;

const variants = {
  accent: "bg-accent-lighter",
  accent2: "bg-accent-2-light",
};
---

<span
  class:list={[
    "inline-flex items-center justify-center rounded-full px-4 py-1 text-[14px] font-medium leading-5 tracking-[1px] text-theme-black whitespace-nowrap",
    variants[variant],
  ]}
>
  {label}
</span>
