---
import Button from "./Button.astro";
import { site } from "../data/site";

interface Props {
  showScrollHint?: boolean;
  scrollHref?: string;
  ctaHref?: string;
  ctaLabel?: string;
  tagline?: string;
  displayWord?: string;
  description?: string;
}

const {
  showScrollHint = true,
  scrollHref = "#servicios",
  ctaHref = site.cta.href,
  ctaLabel = site.cta.label,
  tagline = site.tagline,
  displayWord = site.displayWord,
  description = site.heroDescription,
} = Astro.props;

const heroVideoBase = "/videos/masaje-espalda-palmas-tukura-jerez-bienestar";
const heroPoster =
  "/images/hero/masaje-espalda-palmas-tukura-jerez-bienestar-poster.webp";
const heroMediaLabel =
  "Masaje terapéutico de espalda con las palmas de las manos en TUKURA, centro de masajes y bienestar en Jerez de la Frontera";
---

<section
  class="relative flex min-h-[92dvh] w-full flex-col items-center overflow-hidden rounded-b-[999px] md:min-h-dvh"
  aria-label="Inicio"
>
  {/* Poster first: same LCP role as the previous hero image, no network contention with JS islands */}
  <img
    src={heroPoster}
    alt={heroMediaLabel}
    class="absolute inset-0 h-full w-full object-cover"
    width="1080"
    height="1920"
    fetchpriority="high"
    decoding="async"
    data-hero-poster
  />

  {/* Sources are injected after idle so decode/download never block ScrollReveal / PageScrollFade */}
  <video
    class="absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-700 ease-out motion-reduce:transition-none"
    muted
    loop
    playsinline
    preload="none"
    poster={heroPoster}
    width="1080"
    height="1920"
    aria-hidden="true"
    data-hero-video
    data-src-webm-desktop={`${heroVideoBase}.webm`}
    data-src-mp4-desktop={`${heroVideoBase}.mp4`}
    data-src-webm-mobile={`${heroVideoBase}-720.webm`}
    data-src-mp4-mobile={`${heroVideoBase}-720.mp4`}
  ></video>
  <script is:inline>
    (() => {
      const video = document.querySelector("[data-hero-video]");
      if (!(video instanceof HTMLVideoElement)) return;

      const prefersReducedMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (prefersReducedMotion) return;

      const connection =
        navigator.connection ||
        navigator.mozConnection ||
        navigator.webkitConnection;
      if (connection?.saveData) return;
      if (/(^|-)2g$/i.test(connection?.effectiveType || "")) return;

      let started = false;

      const revealVideo = () => {
        video.classList.remove("opacity-0");
        video.classList.add("opacity-100");
        const poster = document.querySelector("[data-hero-poster]");
        if (poster instanceof HTMLElement) {
          poster.setAttribute("aria-hidden", "true");
        }
      };

      const startHeroVideo = () => {
        if (started) return;
        started = true;

        const useMobile = window.matchMedia("(max-width: 767px)").matches;
        const webm = video.dataset[useMobile ? "srcWebmMobile" : "srcWebmDesktop"];
        const mp4 = video.dataset[useMobile ? "srcMp4Mobile" : "srcMp4Desktop"];
        if (!webm || !mp4) return;

        const webmSource = document.createElement("source");
        webmSource.src = webm;
        webmSource.type = "video/webm";

        const mp4Source = document.createElement("source");
        mp4Source.src = mp4;
        mp4Source.type = "video/mp4";

        video.append(webmSource, mp4Source);
        video.load();

        const tryPlay = () => {
          video.play().then(revealVideo).catch(() => {});
        };

        if (video.readyState >= 2) tryPlay();
        else video.addEventListener("loadeddata", tryPlay, { once: true });
      };

      const scheduleStart = () => {
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(startHeroVideo, { timeout: 2200 });
        } else {
          window.setTimeout(startHeroVideo, 600);
        }
      };

      if (document.readyState === "complete") scheduleStart();
      else window.addEventListener("load", scheduleStart, { once: true });
    })();
  </script>

  <div
    class="absolute inset-0 bg-gradient-to-t from-theme-black/70 via-theme-black/25 to-transparent"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 flex w-full max-w-lg flex-1 flex-col items-center px-5 pb-12 pt-28 md:max-w-2xl md:pb-16 md:pt-40">
    <img
      src="/icons/logo.svg"
      alt=""
      width="106"
      height="64"
      class="mb-auto h-16 w-auto"
      aria-hidden="true"
    />

    <div class="mt-auto flex w-full flex-col items-center gap-10 text-center text-theme-white md:gap-16">
      <div class="flex flex-col items-center gap-4">
        <div class="flex flex-col items-center">
          <p class="text-lg font-normal leading-[26px]">
            {tagline}
          </p>
          <h1 class="font-display text-[72px] leading-[1.1] md:text-[96px] md:leading-[130px]">
            <span class="sr-only">TUKURA — Masajes y bienestar en Jerez de la Frontera. Tu </span>
            {displayWord}
          </h1>
        </div>
        <p class="max-w-md text-base font-normal leading-6 text-theme-white/90 md:text-lg md:leading-7">
          {description}
        </p>
      </div>

      <Button href={ctaHref} label={ctaLabel} variant="secondary" />
    </div>

    {
      showScrollHint && (
        <a
          href={scrollHref}
          data-smooth-scroll
          class="mt-10 inline-flex size-6 items-center justify-center"
          aria-label="Ver más contenido"
        >
          <img
            src="/icons/arrow-down.svg"
            alt=""
            width="24"
            height="24"
            class="size-6 animate-bounce-arrow"
          />
        </a>
      )
    }
  </div>
</section>
