---
import { FaqAccordion } from "./FaqAccordion";
import ScrollReveal from "./ScrollReveal";
import { faqItems } from "../data/faq";
---

<section
  id="faq"
  class="bg-theme-black px-8 py-8 text-theme-white md:px-24 lg:px-32"
  aria-labelledby="faq-title"
>
  <div class="mx-auto flex w-full flex-col gap-8">
    <header class="mx-auto flex w-full max-w-lg flex-col gap-5 md:max-w-2xl">
      <p class="kicker" data-scroll-fade>FAQ</p>
      <ScrollReveal
        client:visible
        as="h2"
        id="faq-title"
        text="¿Tienes alguna duda?"
        textClassName="text-5xl font-semibold leading-[1.15] md:text-6xl"
      />
    </header>

    <div class="mx-auto w-full max-w-lg md:max-w-2xl" data-scroll-fade>
      <FaqAccordion client:load items={faqItems} />
    </div>
  </div>
</section>
