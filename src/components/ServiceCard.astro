---
import Badge from "./Badge.astro";
import type { Service } from "../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
---

<article
  class="flex w-full max-w-[353px] flex-col overflow-hidden rounded-bl-[40px] rounded-tr-[40px] bg-theme-white"
>
  <div class="relative h-[199px] w-full overflow-hidden">
    <img
      src={service.image}
      alt=""
      class="absolute inset-0 h-full w-full object-cover"
      width="353"
      height="199"
      loading="lazy"
    />
  </div>
  <div class="flex flex-col gap-6 p-6">
    <div class="flex flex-wrap gap-2">
      <Badge label={service.price} />
      <Badge label={service.duration} />
    </div>
    <div class="flex flex-col gap-4 text-theme-black">
      <p class="kicker">{service.kicker}</p>
      <h3 class="text-2xl font-semibold leading-8">{service.title}</h3>
      <p class="text-base font-normal leading-6">{service.description}</p>
    </div>
  </div>
</article>
