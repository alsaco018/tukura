---
import Badge from "./Badge.astro";
import type { Service } from "../data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;
const href = `/masajes/${service.id}`;
---

<a
  href={href}
  class="group flex w-full flex-col overflow-hidden rounded-bl-[40px] rounded-tr-[40px] bg-theme-white transition-opacity hover:opacity-95 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
  aria-label={`Ver detalle de ${service.title}`}
>
  <div class="relative aspect-[16/9] w-full overflow-hidden sm:aspect-[2/1]">
    <img
      src={service.image}
      alt={service.imageAlt ?? `${service.title} — masaje en TUKURA Jerez`}
      class={`absolute inset-0 h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.03] ${service.imagePosition ?? ""}`.trim()}
      width="720"
      height="405"
      loading="lazy"
    />
  </div>
  <div class="flex flex-col gap-6 p-6 sm:p-8">
    <div class="flex flex-col gap-4 text-left text-theme-black">
      <p class="kicker">{service.kicker}</p>
      <h3 class="text-2xl font-semibold leading-8 sm:text-[28px] sm:leading-9">{service.title}</h3>
      <p class="text-base font-normal leading-6">{service.description}</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <Badge label={service.price} />
      <Badge label={service.duration} />
    </div>
  </div>
</a>
