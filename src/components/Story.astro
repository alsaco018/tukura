---
import Button from "./Button.astro";
import ScrollReveal from "./ScrollReveal";
import { site } from "../data/site";

const { story } = site;
---

<section
  id="historia"
  class="relative overflow-hidden bg-brand-light"
  aria-labelledby="historia-title"
>
  <img
    src={story.decoration}
    alt=""
    class="pointer-events-none absolute left-[-290px] top-[159px] h-[402px] w-[663px] max-w-none"
    width="663"
    height="402"
    aria-hidden="true"
    data-scroll-fade

  />

  <div class="relative mx-auto flex w-full max-w-lg flex-col gap-6 px-5 pb-10 pt-10">
    <div class="flex flex-col gap-5 text-theme-black">
      <p class="kicker" data-scroll-fade>{story.kicker}</p>
      <h2 id="historia-title" class="flex flex-col gap-1 text-[32px] font-semibold leading-10 md:text-4xl md:leading-[44px]">
        {
          story.lines.map((line) => (
            <ScrollReveal
              client:visible
              as="span"
              containerClassName="block"
              text={`${line.accent}${line.rest}`}
              textClassName="text-[32px] font-semibold leading-10 md:text-4xl md:leading-[44px]"
              accentWords={[line.accent]}
              accentClassName="text-accent"
            />
          ))
        }
      </h2>
      <div class="flex flex-col gap-1 text-lg font-normal leading-7">
        {
          story.paragraphs.map((paragraph) => (
            <ScrollReveal
              client:visible
              as="p"
              text={paragraph}
              textClassName="text-lg font-normal leading-7"
            />
          ))
        }
      </div>
    </div>

    <Button href={story.ctaHref} label={story.ctaLabel} variant="primary" scrollFade />
  </div>
</section>
