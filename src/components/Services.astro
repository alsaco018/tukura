---
import { ServicesStack } from "./ServicesStack";
import ScrollReveal from "./ScrollReveal";
import { services } from "../data/services";
---

<section
  id="servicios"
  class="bg-brand-light px-5 py-10"
  aria-labelledby="servicios-title"
>
  <div class="mx-auto flex w-full max-w-lg flex-col gap-6 md:max-w-2xl">
    <header class="flex flex-col gap-5 text-theme-black">
      <p class="kicker" data-scroll-fade>Nuestros servicios</p>
      <ScrollReveal
        client:visible
        as="h2"
        id="servicios-title"
        text="Dedícate un momento"
        textClassName="text-5xl font-semibold leading-[1.15] md:text-6xl"
      />
    </header>

    <div data-scroll-fade data-scroll-fade-y="40">
      <ServicesStack client:visible services={services} />
    </div>
  </div>
</section>
