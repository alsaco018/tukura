---
import { ServicesStack } from "./ServicesStack";
import ScrollReveal from "./ScrollReveal";
import { services } from "../data/services";
import { site } from "../data/site";

const { servicesIntro } = site;
---

<section
  id="servicios"
  class="bg-brand-light px-5 py-10"
  aria-labelledby="servicios-title"
>
  <div class="mx-auto flex w-full max-w-lg flex-col gap-6 md:max-w-2xl">
    <header class="flex flex-col gap-5 text-theme-black">
      <p class="kicker" data-scroll-fade>{servicesIntro.kicker}</p>
      <ScrollReveal
        client:visible
        as="h2"
        id="servicios-title"
        text={servicesIntro.title}
        textClassName="text-5xl font-semibold leading-[1.15] md:text-6xl"
      />
      <ScrollReveal
        client:visible
        as="p"
        text={servicesIntro.subtitle}
        textClassName="text-lg font-normal leading-7"
      />
    </header>

    {/* No data-scroll-fade here: opacity on a sticky ancestor breaks pin release. */}
    <ServicesStack client:visible services={services} />
  </div>
</section>
