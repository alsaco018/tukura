---
import { site } from "../data/site";
import { LegalLinks } from "./LegalLinks";

interface Props {
  simplified?: boolean;
}

const { simplified = false } = Astro.props;
const footerLinks = site.footerNav;
---

<footer class="bg-theme-black text-theme-white">
  <div class="mx-auto flex w-full max-w-lg flex-col gap-10 px-5 py-8 md:max-w-2xl">
    {
      !simplified && (
        <div class="flex flex-col gap-6">
          <p class="kicker">Explora</p>
          <nav aria-label="Pie de página" class="grid grid-cols-2 gap-6">
            {footerLinks.map((item) => (
              <a
                href={item.href}
                class="text-base font-normal leading-6 transition-opacity hover:opacity-80"
              >
                {item.label}
              </a>
            ))}
          </nav>
        </div>
      )
    }

    <div class="flex flex-col gap-2.5">
      <p class="kicker">sígueme</p>
      <ul class="flex gap-6" role="list">
        {
          site.social.map((item) => (
            <li>
              <a
                href={item.href}
                class="inline-flex size-11 items-center justify-center rounded-full bg-accent transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent-lighter"
                aria-label={item.label}
                target={item.href.startsWith("http") ? "_blank" : undefined}
                rel={item.href.startsWith("http") ? "noopener noreferrer" : undefined}
              >
                <img src={item.icon} alt="" width="24" height="24" class="size-6" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="border-t border-accent px-5 py-2.5">
    <LegalLinks client:visible />
  </div>
</footer>
