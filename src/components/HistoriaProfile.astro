---
import ScrollReveal from "./ScrollReveal";
import { historia } from "../data/historia";

const { profile } = historia;
---

<section
  class="bg-accent pt-28 text-theme-white"
  aria-labelledby="quien-soy-page-title"
>
  <div class="mx-auto flex w-full max-w-lg flex-col gap-6 px-5 md:max-w-2xl">
    <div class="flex flex-col gap-5">
      <p class="kicker" data-scroll-fade>{profile.kicker}</p>
      <ScrollReveal
        client:visible
        as="h1"
        id="quien-soy-page-title"
        text={profile.name}
        textClassName="text-5xl font-semibold leading-[1.15] md:text-6xl"
      />
      <ScrollReveal
        client:visible
        as="p"
        text={profile.role}
        textClassName="text-lg font-normal leading-7"
      />
      {
        profile.paragraphs.map((paragraph) => (
          <ScrollReveal
            client:visible
            as="p"
            text={paragraph}
            textClassName="text-lg font-normal leading-7"
          />
        ))
      }
    </div>

    <blockquote class="border-l-2 border-theme-white pl-6">
      <ScrollReveal
        client:visible
        as="p"
        text={profile.quote}
        textClassName="text-xl italic leading-[28px]"
      />
    </blockquote>

    <div class="flex flex-col gap-3">
      <p class="kicker" data-scroll-fade>{profile.formation.kicker}</p>
      <ScrollReveal
        client:visible
        as="p"
        text={profile.formation.items}
        textClassName="text-lg font-normal leading-7"
      />
      <ScrollReveal
        client:visible
        as="p"
        text={profile.formation.note}
        textClassName="text-lg font-normal leading-7"
      />
    </div>
  </div>

  <div class="mt-6 h-[520px] w-full overflow-hidden md:h-[640px] lg:h-[720px]" data-scroll-fade>
    <img
      src={profile.image}
      alt={profile.imageAlt}
      class="h-full w-full object-cover object-[center_28%]"
      width="1600"
      height="2145"
      loading="lazy"
    />
  </div>
</section>
