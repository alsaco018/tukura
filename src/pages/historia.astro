---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import HistoriaHero from "../components/HistoriaHero.astro";
import HistoriaBody from "../components/HistoriaBody.astro";
import HistoriaPrinciples from "../components/HistoriaPrinciples.astro";
import HistoriaProfile from "../components/HistoriaProfile.astro";
import Footer from "../components/Footer.astro";
import { site } from "../data/site";
---

<BaseLayout
  title={`${site.name} — Nuestra historia`}
  description="Conoce la historia de TUKURA y de Patricia Guillén: un espacio seguro para bajar el ritmo y recibir cuidado."
>
  <Header />
  <main id="main-content">
    <HistoriaHero />
    <HistoriaBody />
    <HistoriaPrinciples />
    <HistoriaProfile />
  </main>
  <Footer />
</BaseLayout>
