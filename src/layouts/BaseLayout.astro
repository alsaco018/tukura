---
import "../styles/global.css";
import PageClickSpark from "../components/PageClickSpark";
import PageScrollFade from "../components/PageScrollFade";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "TUKURA — Masajes y bienestar",
  description = "Centro de masajes y bienestar. Un espacio seguro y amable para bajar el ritmo y recibir cuidado.",
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#fbf4ef" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="m-0 min-h-dvh font-sans antialiased text-theme-black bg-brand-light">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:rounded-full focus:bg-theme-black focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-theme-white"
    >
      Saltar al contenido
    </a>
    <slot />
    <PageScrollFade client:load />
    <PageClickSpark client:load />
  </body>
</html>
